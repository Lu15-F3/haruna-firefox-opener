{
  "manifest_version": 3,
  "name": "Abrir no Haruna",
  "version": "1.3",
  "description": "Adiciona opções no menu de contexto para abrir vídeos e playlists no player Haruna.",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "icons": {
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "haruna-opener@lu15-f3-dev.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}