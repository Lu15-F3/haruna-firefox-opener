{
  "manifest_version": 3,
  "name": "Abrir no Haruna",
  "version": "1.1",
  "description": "Adiciona uma opção no menu de contexto para abrir vídeos no player Haruna.",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "icons": {
    "48": "icone-48.png",
    "128": "icone-128.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "haruna-opener@lu15-f3-dev.org",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
